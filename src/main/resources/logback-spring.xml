<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration that switches encoders by Spring profile:
    - prod:         JSON via logstash-logback-encoder so log aggregators
                    (Elasticsearch, Loki, Datadog) index MDC fields and the
                    trace_id / span_id as first-class JSON keys.
    - default/dev:  human-friendly pattern kept identical to application.yml's
                    pattern for parity with existing developer workflows.

  Spring Boot's defaults (level overrides, file appenders, debug/trace) are
  still inherited from spring-boot logback-base.xml.
-->
<configuration scan="false">

    <!-- Pull Spring Boot defaults so level overrides and logger names still apply -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="task-scheduler"/>

    <!-- ============================================================ -->
    <!-- Production profile: structured JSON                          -->
    <!-- ============================================================ -->
    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <fieldName>@timestamp</fieldName>
                        <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
                    </timestamp>
                    <version>
                        <fieldName>@version</fieldName>
                    </version>
                    <pattern>
                        <pattern>
                            {
                                "service": "${appName}",
                                "level": "%level",
                                "thread": "%thread",
                                "logger": "%logger",
                                "message": "%message"
                            }
                        </pattern>
                    </pattern>
                    <!-- MDC fields (taskId, taskType, referenceId) and Micrometer
                         Tracing fields (traceId, spanId) flow through as top-level
                         JSON keys, so log queries can filter on them without regex. -->
                    <mdc/>
                    <stackTrace>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>50</maxDepthPerThrowable>
                            <maxLength>4096</maxLength>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <!-- ============================================================ -->
    <!-- Default / dev / test: human-readable pattern (kept identical -->
    <!-- to application.yml's logging.pattern.console for parity)     -->
    <!-- ============================================================ -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-},%X{spanId:-}] %logger{36} [taskId=%X{taskId} taskType=%X{taskType} ref=%X{referenceId}] - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
