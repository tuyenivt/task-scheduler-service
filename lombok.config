# Lombok stops searching for further config files when this one is encountered.
config.stopBubbling = true

# Copy Spring's @Lazy and @Qualifier from fields onto the matching constructor
# parameters that @RequiredArgsConstructor generates. Without this, a field like
#   @Lazy private final TaskExecutorService self;
# becomes a constructor parameter without @Lazy, and Spring tries to fully
# construct the same bean before injecting it - producing a
# BeanCurrentlyInCreationException for self-injected services.
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
